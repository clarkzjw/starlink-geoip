# Environment for starlink-geoip-scheduler.service (systemd EnvironmentFile syntax:
# no shell expansion, no quotes needed).

# Work folder: persistent data-repo clone (state/), run folders, logs.
SG_WORK_DIR=/home/USER/code/starlink-geoip/work

SG_DATA_REMOTE=git@github.com:clarkzjw/starlink-geoip-data.git
SG_DATA_BRANCH=master

# Commit identity (optional; falls back to git config).
#SG_GIT_USER_NAME=
#SG_GIT_USER_EMAIL=

# Deploy key with write access to the data repo.
GIT_SSH_COMMAND=ssh -i /home/USER/.ssh/starlink_geoip_data_deploy -o IdentitiesOnly=yes

# systemd's PATH is minimal: dig (dnsutils) for geoip_ptr, npx (geobuf) for availability.
PATH=/home/USER/.nvm/versions/node/v22.14.0/bin:/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin

#SG_LOG_DAYS=14
#SG_KEEP_FAILED_DAYS=7
